#
# pcal-live: what runs on tty1 of the PCal live ISO (from /etc/inittab).
#
# On the live ISO (root filesystem in RAM) it starts the PCal menu as root, in the
# graphical screen, so the ISO boots straight into PCal. Alpine's installer copies the live
# system's /etc/inittab to the disk, so on an installed system this same line
# runs again. There it never starts a root menu. Instead:
#   - first start after the PCal installer: it finds /etc/pcal/firstboot (left
#     by the installer), runs pcal-setup for that user, and shows RetroLogin;
#   - once pcal-setup has pointed tty1 elsewhere: it starts that (RetroLogin);
#   - otherwise: the normal login prompt, with a hint to run pcal-setup.
FIRSTBOOT=/etc/pcal/firstboot
INITTAB=/etc/inittab

# Only init (on tty1, from /etc/inittab) should start this. Run by hand from a shell,
# getty can't take over the terminal ("setsid: Operation not permitted"), so explain instead.
if [ "$PPID" != 1 ] && [ "${PCAL_LIVE_FORCE:-}" != 1 ]; then
    echo "pcal-live is started by the system on tty1 (see /etc/inittab); there's nothing to run by hand."
    echo "To set up the PCal login screen and menu on an installed system, run (as root): pcal-setup"
    exit 0
fi

root_fs=$(awk '$2 == "/" { fs = $3 } END { print fs }' /proc/mounts 2>/dev/null)

if [ "${PCAL_LIVE_FORCE:-}" != 1 ] && [ "$root_fs" != tmpfs ]; then
    # ---- installed system
    if [ -f "$FIRSTBOOT" ]; then
        user=$(head -n1 "$FIRSTBOOT")
        printf '\n  \033[1;32mPCAL -- FIRST START\033[0m  finishing the setup for %s ...\n\n' "$user"
        if /usr/sbin/pcal-setup "$user"; then
            rm -f "$FIRSTBOOT"
            sleep 2
        else
            printf '\n  pcal-setup did not finish. Log in as root (Alt+F2) and run:  pcal-setup %s\n\n' "$user"
            sleep 5
        fi
    fi
    # pcal-setup points tty1 at RetroLogin; init may still run this old line until the
    # next boot, so start whatever tty1 should run now
    tty1=$(sed -n 's/^tty1::respawn://p' "$INITTAB" 2>/dev/null | head -n1)
    case "$tty1" in
        "" | */pcal-live*) ;;
        # shellcheck disable=SC2086
        *) exec $tty1 ;;
    esac
    # pcal-setup hasn't run yet
    printf '\n  \033[1;32mPCal is installed.\033[0m To switch on the PCal login screen and menu,\n'
    printf '  log in as \033[1mroot\033[0m and run:  \033[1;32mpcal-setup\033[0m   (then reboot)\n\n'
    exec /sbin/getty 38400 tty1  # normal login
fi

export HOME=/root USER=root LOGNAME=root SHELL=/bin/ash
export TERM="${TERM:-linux}" LANG="${LANG:-C.UTF-8}"
cd /root 2>/dev/null || cd /
# The graphical screen around the menu (Settings > Display can switch it to text);
# without graphics it starts the text menu by itself.
exec /usr/bin/pontes screen --tty1 -- /usr/bin/retromenu
